  "attribution": {
    "status": "corrected-offline",
    "correction": "The inline snapshot parser in i2r4-linux-attribution.mjs read node field index 2 as self_size and the type index as the constructor name. In this Chromium build the layout is node_fields=[type, name, id, self_size, edge_count, detachedness], so those reads hit id and type instead; the typeSelfSizeDeltaKB and topObjectConstructorDeltas below this replacement were therefore wrong (implausible multi-GB string/number deltas, no Object/Array rows). The committed script now derives every index from meta.node_fields/edge_fields (2026-11-06 correction). The corrected, layout-driven attribution including full retainer-chain ownership buckets is i2r4-retainer-attribution.json next to this file; its headline values: code +554 KB, object +3 KB, object shape +6 KB, closure 0, array 0, detached 0 to 0, generic Object +103 / Array +32 attributed via retainer buckets (react-runtime, dom-window, v8-compilation, single-digit tour-classified nodes whose chains resolve to the probe-mounted onboarding module code/prototype machinery and React hook state, not retained tour data).",
    "priorBuggyParseSummary": {
      "typeSelfSizeDeltaKB": {
        "synthetic": 119,
        "native": -40148,
        "string": 2617677,
        "object shape": 48326,
        "code": 1005191,
        "array": 20645,
        "number": 2270202,
        "symbol": 0,
        "object": 80233,
        "closure": 2198,
        "concatenated string": -48410,
        "regexp": 0,
        "sliced string": -14116
      },
      "note": "retained as evidence of the defect this correction fixes"
    },
    "correctedArtifact": "i2r4-retainer-attribution.json"
  },
