MONGODB_URI=MONGODB_URI_HERE
# Database name. Production MUST be aics_portal (set explicitly; tooling
# aborts when unset). QA/isolated runs use aics_portal_qa.
MONGODB_DB=aics_portal
# Session JWT signing secret (16+ chars). Required in production —
# login refuses to issue sessions without it. Dev falls back to an
# insecure default with a console warning; never rely on that fallback
# outside localhost.
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# ROTATION ERA (2026-09-10): the Atlas credential in
# MONGODB_URI was rotated post-rehash; set the NEW value here at deploy
# time. Never commit this file.