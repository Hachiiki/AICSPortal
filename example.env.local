# AICS Portal — environment template
#
# Copy to .env.local for local development (never commit the copy):
#   cp example.env.local .env.local
#
# Environment separation (see docs/environments.md for the full matrix):
#   development  local .env.local        — dev fallbacks allowed, banner on
#   staging      Vercel Preview env      — AUTH_SECRET required, DB defaults
#                                           to aics_portal_staging
#   production   Vercel Production env   — everything required, no banner
#
# The app resolves the environment in src/lib/env.ts (APP_ENV override,
# then VERCEL_ENV, then NODE_ENV).

# --- required in every environment -----------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name. Set explicitly everywhere — never rely on defaults:
#   development  aics_portal (local seed)
#   staging      aics_portal_staging
#   production   aics_portal  (MUST be set explicitly; tooling aborts when unset)
MONGODB_DB=aics_portal

# Session JWT signing secret, 16+ chars (generate with: openssl rand -hex 32).
# Required in staging and production — login REFUSES to issue sessions
# without it. Development falls back to an insecure default with a warning;
# never rely on that fallback outside localhost.
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- optional: profile photos + course-material uploads --------------------
# Course-material uploads (refs #35) and avatar uploads. All three required
# for the Upload tabs / photo uploader; without them signing refuses (503)
# and the link-only flow keeps working. Same values must be set as Vercel
# env vars (scoped per environment).
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=CLOUDINARY_CLOUD_NAME_SECRET_HERE

# Optional base folder for uploads (default aics-portal/materials).
# Files land in <folder>/<branch>/<SUBJECT-CODE>/.
# CLOUDINARY_FOLDER=aics-portal/materials

# --- optional: content moderation -------------------------------------------
# Extra trusted domains for the URL policy in src/lib/moderation/ (comma-
# separated). The school site, Cloudinary, and the LMS are always trusted.
# MODERATION_TRUSTED_DOMAINS=intranet.aics.edu.ph,lms.example.com

# --- optional: explicit environment override --------------------------------
# Forces src/lib/env.ts classification when neither VERCEL_ENV nor
# NODE_ENV says the truth (bare `next start` on a staging box, drills).
# One of: development | staging | production
# APP_ENV=development
