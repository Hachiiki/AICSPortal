# Copy this template to .env.local. Keep real values outside Git.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=aics_portal_local
# Generate a separate value per environment with: openssl rand -hex 32
AUTH_SECRET=

# Sign-in demo is available only in next dev and only when opted in.
# NEXT_PUBLIC_ENABLE_DEV_DEMO=true

# Vercel Cron bearer secret, when scheduled notification cleanup is enabled.
# CRON_SECRET=

# Optional profile photo and course material Cloudinary uploads.
# Each preset must be signed, permit server-supplied public IDs, enforce
# an allowed format list, and use the upload delivery type.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=aics-portal/materials
# CLOUDINARY_PHOTO_UPLOAD_PRESET=
# CLOUDINARY_MATERIAL_IMAGE_UPLOAD_PRESET=
# CLOUDINARY_MATERIAL_RAW_UPLOAD_PRESET=

# Optional email verification. Use a verified Resend sender.
# APP_PUBLIC_ORIGIN=https://portal.example.com
# RESEND_API_KEY=
# EMAIL_VERIFICATION_FROM=portal@example.com

# Only when Caddy terminates HTTPS and is the app's sole ingress.
# TRUST_CADDY_PROXY=1
# PORTAL_HOST=portal.example.com

# MODERATION_TRUSTED_DOMAINS=intranet.aics.edu.ph,lms.example.com
